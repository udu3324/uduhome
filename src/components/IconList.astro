---
import { Image } from "astro:assets"
import Tooltip from "./Tooltip.astro"


const images = import.meta.glob("../assets/icons/*.png", { eager: true })


---

<div class="flex flex-wrap leading-none pt-2">
{
    Object.entries(images).map(([path, img]) => (
        <div id="icon-image" class="pr-1 w-9 h-9">
            <Tooltip text={path.substring(path.lastIndexOf("/") + 1, path.lastIndexOf("."))}>
                <Image
                    src={img.default}
                    alt="icon"
                    width="100"
                    height="100"
                    loading="eager"
                />
            </Tooltip>
        </div>
    ))
}
</div>

<style>
    @reference "tailwindcss";

    @media only screen and (max-width: 480px) {
        #icon-image {
            @apply w-7 h-7
        }
    }
</style>